<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Device-to-device transfer ignores android:allowBackup, so
     the secure-storage files are excluded explicitly from both cloud backup
     and device transfer. The buyer signs in again on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
