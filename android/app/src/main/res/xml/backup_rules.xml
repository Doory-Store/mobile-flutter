<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Backup is off (android:allowBackup="false"); these
     rules keep the secure-storage files out even if it is turned back on.
     Keystore keys never leave the device, so a restored copy could not be
     decrypted anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
